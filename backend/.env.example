PORT=3001
HOST=127.0.0.1
ADMIN_USERNAME=admin
# Run npm run admin:setup to generate an ignored .env and local access file.
ADMIN_PASSWORD_HASH=
# Set true only when serving behind HTTPS.
COOKIE_SECURE=false
# Customer order emails stay queued until sending is configured.
EMAIL_PROVIDER=disabled
# To send: use EMAIL_PROVIDER=resend, a Resend API key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Alternative: EMAIL_PROVIDER=gmail with a Google app password (not your account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Vercel only: pooled Neon PostgreSQL connection, stored in private server settings.
DATABASE_URL=
# Local testing only; codes are shown in the browser, not sent as SMS.
# For live SMS: select sms mode and configure the provider below.
CUSTOMER_AUTH_MODE=disabled
SMS_PROVIDER=disabled
# Optional Sparrow SMS adapter; use the approved sender identity from your account.
SPARROW_SMS_TOKEN=
SPARROW_SMS_SENDER=

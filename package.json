{
  "name": "machhapuchhree-electronics",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "admin:setup": "node backend/setup-admin.mjs",
    "sms:setup": "node backend/setup-sms.mjs",
    "sms:check": "node backend/setup-sms.mjs --check",
    "test:backend": "node --test backend/test/*.test.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "deploy:test": "node scripts/verify-neon.mjs",
    "deploy:configure": "node scripts/configure-vercel.mjs",
    "format": "prettier --write frontend/src frontend/vite.config.ts frontend/tsconfig.json frontend/index.html frontend/package.json backend/*.mjs backend/test/*.mjs scripts/*.cjs scripts/*.mjs package.json README.md"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}

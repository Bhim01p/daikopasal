PORT=3001
HOST=127.0.0.1
ADMIN_USERNAME=admin
# Run npm run admin:setup to generate an ignored .env and local access file.
ADMIN_PASSWORD_HASH=
# Set true only when serving behind HTTPS.
COOKIE_SECURE=false
# Customer order emails stay queued until sending is configured.
EMAIL_PROVIDER=disabled
# To send: use EMAIL_PROVIDER=resend, a Resend API key and a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Alternative: EMAIL_PROVIDER=gmail with a Google app password (not your account password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Vercel only: pooled Neon PostgreSQL connection, stored in private server settings.
DATABASE_URL=
# Email-code login requires the configured Gmail or other mail transport.
CUSTOMER_AUTH_MODE=email
# SMS is not used by the deployed website.
SMS_PROVIDER=disabled
